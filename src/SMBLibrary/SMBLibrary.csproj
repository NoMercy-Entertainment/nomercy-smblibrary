<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NoMercy.SMBLibrary</AssemblyName>
    <PackageId>NoMercy.SMBLibrary</PackageId>
    <Version>1.5.7-nomercy.1</Version>
    <NoWarn>1573;1591;0618</NoWarn>
    <RootNamespace>SMBLibrary</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Tal Aloni; NoMercy Entertainment</Authors>
    <Copyright>Copyright © Tal Aloni 2014-2026</Copyright>
    <PackageDescription>NoMercy fork of SMBLibrary: pure C# SMB 1.0/CIFS, 2.0/2.1 and 3.0, client and server. Adds a public Connect overload with an explicit port, so the client can reach an SMB server on any port, not only 445.</PackageDescription>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>smb;cifs;smb2;smb3;samba;file-share;network-share</PackageTags>
    <RepositoryUrl>https://github.com/NoMercy-Entertainment/nomercy-smblibrary</RepositoryUrl>
    <PackageProjectUrl>https://github.com/NoMercy-Entertainment/nomercy-smblibrary</PackageProjectUrl>
    <!-- Utilities is private to this package: ship its DLL inside it rather than as a -->
    <!-- second package, so one package ID is the whole client.                       -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeUtilitiesInPackage</TargetsForTfmSpecificBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utilities\Utilities.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>

  <Target Name="IncludeUtilitiesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>

</Project>
