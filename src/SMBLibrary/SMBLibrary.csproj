<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NoMercy.SMBLibrary</AssemblyName>
    <Version>1.5.7-nomercy.1</Version>
    <NoWarn>1573;1591;0618</NoWarn>
    <RootNamespace>SMBLibrary</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Tal Aloni; NoMercy Entertainment</Authors>
    <Copyright>Copyright © Tal Aloni 2014-2026</Copyright>
    <PackageDescription>NoMercy fork of SMBLibrary (SMB 1.0/2.0/2.1/3.0 client). Adds a public Connect overload that accepts an explicit port, so the client can reach an SMB server on a non-445 port.</PackageDescription>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TalAloni/SMBLibrary</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utilities\Utilities.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>

</Project>
